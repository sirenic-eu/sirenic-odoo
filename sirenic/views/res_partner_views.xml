<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_sirenic" model="ir.ui.view">
    <field name="name">res.partner.form.sirenic</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <!-- Le geste principal est un bouton d'en-tête : « puis-je payer ce
           fournisseur ». Les vingt autres vérifications passent par
           l'assistant, pour ne pas encombrer la fiche. -->
      <xpath expr="//div[@name='button_box']" position="before">
        <header>
          <button name="action_sirenic_dossier" type="object" string="Vérifier avec Sirenic"
                  class="btn-primary" invisible="not is_company"/>
          <button name="action_sirenic_kyb" type="object" string="Dossier KYB"
                  invisible="not is_company"/>
          <button name="action_sirenic_completer" type="object" string="Compléter depuis le registre"
                  invisible="not is_company"/>
          <button name="%(action_sirenic_verification)d" type="action" string="Autre vérification…"
                  invisible="not is_company"
                  context="{'default_partner_id': id}"/>
        </header>
      </xpath>
    </field>
  </record>
</odoo>
