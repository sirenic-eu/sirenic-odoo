<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sirenic_verification_form" model="ir.ui.view">
    <field name="name">sirenic.verification.form</field>
    <field name="model">sirenic.verification</field>
    <field name="arch" type="xml">
      <form string="Vérification Sirenic">
        <group>
          <field name="partner_id" readonly="1"/>
          <field name="route"/>
          <field name="prix" readonly="1"/>
        </group>
        <field name="resultat" widget="ace" options="{'mode': 'json'}" readonly="1"
               invisible="not resultat"/>
        <footer>
          <button name="action_verifier" type="object" string="Lancer la vérification"
                  class="btn-primary" invisible="not route"/>
          <button string="Fermer" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_sirenic_verification" model="ir.actions.act_window">
    <field name="name">Vérification Sirenic</field>
    <field name="res_model">sirenic.verification</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
